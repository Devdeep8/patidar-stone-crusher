{
  "name": "crm-simple-mvp-backend",
  "version": "1.0.0",
  "description": "Backend server for CRM Simple MVP",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "tsx index.js",
    "dev:nodemon": "nodemon --watch . --ext js,mjs,cjs,json,ts,tsx --ignore node_modules --ignore .git --exec tsx index.js",
    "start": "node index.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:migration:create": "node scripts/create-migration.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "compression": "^1.8.1",
    "convict": "^6.2.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "http-status-codes": "^2.3.0",
    "i18n": "^0.15.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "multer": "^2.2.0",
    "nanoid": "^5.1.16",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.0",
    "sequelize": "^6.37.8",
    "tsx": "^4.7.0",
    "uuid": "^14.0.1",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "sequelize-cli": "^6.6.5"
  }
}
