# Copy to executor/.env and fill in before `docker compose -f docker-compose.production.yml up -d`
# Used for compose variable interpolation (container infrastructure credentials).

# Postgres (backends read these via the compose environment overrides)
POSTGRES_DB=patidar-stone-crusher-website-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# Restricted runtime account for user-backend (CRUD only)
APP_DB_USERNAME=patidar_app
APP_DB_PASSWORD=change-me-another-strong-password

# Redis (audit queue) — backends read this via the compose environment overrides
REDIS_PASSWORD=change-me-strong-password
